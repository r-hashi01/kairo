{
  "name": "kairo-sdk",
  "version": "0.1.0",
  "description": "Durable workflows that run inside your Node process: a WASM core and your database (SQLite or PostgreSQL). No workflow server.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:wasm": "cd ../.. && GOOS=wasip1 GOARCH=wasm go build -trimpath -buildmode=c-shared -o sdk/ts/wasm/kairo.wasm ./cmd/kairo-wasm",
    "build": "npm run build:wasm && tsc -p tsconfig.json",
    "test": "node --test src/*.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r-hashi01/kairo.git",
    "directory": "sdk/ts"
  },
  "homepage": "https://github.com/r-hashi01/kairo#readme",
  "keywords": [
    "workflow",
    "durable-execution",
    "workflow-engine",
    "serverless",
    "webassembly",
    "llm",
    "agents"
  ]
}
